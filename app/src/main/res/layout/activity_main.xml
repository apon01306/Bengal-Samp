<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- শিরোনাম -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- কীভাবে খেলবে -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/how_to_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvHowTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/how_to_text"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- নাম -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nickname_label"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nickname_hint"
            android:inputType="text"
            android:maxLength="24"
            android:layout_marginBottom="16dp" />

        <!-- সার্ভার তালিকা -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/server_label"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerServers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvServerIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/server_ip_label"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvServerPlayers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/server_players_label"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvServerMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/server_mode_label"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSampleWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_warning"
            android:textSize="13sp"
            android:textColor="@color/colorWarning"
            android:layout_marginBottom="16dp" />

        <!-- UPDATE -->
        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/update_button"
            android:textSize="18sp"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCancelDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cancel_button"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressDownload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDownloadInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvGameFileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_no_file"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- PLAY -->
        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_button"
            android:textSize="20sp"
            android:enabled="false"
            android:backgroundTint="@color/colorAccent"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCopyIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copy_ip_button"
            android:layout_marginBottom="16dp" />

        <!-- নিজের সার্ভার যোগ করো -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_server_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etCustomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_name_hint"
            android:inputType="text"
            android:maxLength="24" />

        <EditText
            android:id="@+id/etCustomIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_ip_hint"
            android:inputType="textUri"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAddServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_server_button"
            android:layout_marginBottom="16dp" />

        <!-- Discord -->
        <Button
            android:id="@+id/btnDiscord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/discord_button"
            android:backgroundTint="#5865F2"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp" />

        <!-- অবস্থা -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_ready"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/footer_note"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
